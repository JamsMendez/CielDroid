<?xml version="1.0" encoding="utf-8"?>
<!-- Ciel logo inside the adaptive icon safe zone: a 20% inset keeps it within the 66dp of 108dp circle. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="20%">
    <bitmap
        android:filter="true"
        android:gravity="fill"
        android:src="@drawable/ciel_logo" />
</inset>
